# Copia este archivo como ".env" (en la raíz del proyecto) y completa los valores.
# El archivo ".env" NO se sube al repositorio.

# --- Base de datos (PostgreSQL 16 en Docker) ---
DB_NAME=erp_agm_irl
DB_USER=erp_agm
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# --- Django ---
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Usuarios de prueba (solo para el comando seed_demo) ---
# Contraseña común de los usuarios DEMO. Si se deja vacía, seed_demo genera una al azar y la muestra.
DEMO_PASSWORD=
